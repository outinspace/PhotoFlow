# Copy this to worker/.env and fill it in; the worker loads that file on startup.
# Real environment variables take precedence over it, so in GitHub Actions these
# come from repository secrets and variables instead and no .env is needed —
# see .github/workflows/process.yml.

# --- Secrets: the write-only key the worker uses -----------------------------
# Scope this key to a single bucket. It needs read and write on that bucket, and
# nothing else in your account.
PHOTOFLOW_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
PHOTOFLOW_S3_BUCKET=my-photos
PHOTOFLOW_S3_ACCESS_KEY_ID=
PHOTOFLOW_S3_SECRET_ACCESS_KEY=

# --- Variables: not secret ---------------------------------------------------
PHOTOFLOW_S3_REGION=us-west-004

# Ceiling per run, so an initial import of a large library cannot exhaust your
# CI minutes in one go. Leftovers are picked up by the next run.
# Locally, `photoflow-worker --until-empty` runs batch after batch of this size,
# publishing each one, until nothing is left waiting.
PHOTOFLOW_MAX_FILES_PER_RUN=2000

# How many already-catalogued files to repair per run — thumbnails or search
# vectors that are missing, which is what a migration leaves behind. Raise it when
# running locally to work through a backlog in one go.
PHOTOFLOW_MAX_BACKFILL_PER_RUN=500

# Videos at or under this height that already use H.264 are served as their own
# preview instead of being transcoded into a near-duplicate file.
PHOTOFLOW_PASSTHROUGH_MAX_HEIGHT=1080

# Quality of a transcoded preview. The worker uses the hardware encoder when the
# machine has one and libx264 when it does not; the two scales are unrelated, so
# there is a setting for each. Higher is better for the hardware one, lower is
# better for the software one. The defaults were matched to give the same size.
PHOTOFLOW_VIDEO_QUALITY_HARDWARE=40
PHOTOFLOW_VIDEO_QUALITY_SOFTWARE=28

# Optional. A https://healthchecks.io ping URL; the worker pings it on success
# and pings <url>/fail on failure, so a night that never ran reaches you.
PHOTOFLOW_HEALTHCHECK_URL=
